# Novus - Environment Variables Example
# Copy this file to .env and replace the values with your production secrets.
# Do NOT commit your actual .env file to version control.

# Backend Configuration (Spring Boot)
# The JWT secret must be at least 256 bits (32 characters) long for HS256.
JWT_SECRET=your_production_secure_jwt_secret_here

# Database Configuration
DB_USERNAME=root
DB_PASSWORD=your_production_database_password
